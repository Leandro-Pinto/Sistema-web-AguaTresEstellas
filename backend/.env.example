# =====================================================================
#  VARIABLES DE ENTORNO - SISTEMA WEB AGUA TRES ESTRELLAS PURA
#  Copiar como .env y ajustar los valores.
#  NUNCA subir el archivo .env al repositorio.
# =====================================================================

# --- Base de datos (MySQL / MariaDB) -------------------------------
DATABASE_URL="mysql://agua_app:AguaTresEstrellas2026@127.0.0.1:3306/agua_tres_estrellas"
# Base separada que usan las pruebas automatizadas (Jest/Supertest), de modo
# que ejecutar los tests nunca altera los datos del postest.
DATABASE_URL_TEST="mysql://agua_app:AguaTresEstrellas2026@127.0.0.1:3306/agua_tres_estrellas_test"

# --- Servidor ------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api
# Origen permitido por CORS (frontend en desarrollo)
CORS_ORIGIN=http://localhost:5173

# --- Seguridad / JWT ----------------------------------------------
# Longitud mínima recomendada: 64 caracteres
JWT_SECRET=cambie-esta-clave-por-una-cadena-aleatoria-de-al-menos-64-caracteres-para-produccion
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=cambie-esta-clave-de-refresco-por-otra-cadena-aleatoria-de-64-caracteres
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
# intentos de login fallidos antes del bloqueo temporal
MAX_INTENTOS_LOGIN=5
MINUTOS_BLOQUEO_LOGIN=15

# --- Reglas de negocio configurables -------------------------------
# Permite al administrador activar "permitir stock negativo" (politica
# especial de inventario). Por defecto false.
PERMITIR_STOCK_NEGATIVO=false
# Permite registrar devoluciones de bidones mayores al saldo del cliente
PERMITIR_DEVOLUCION_EXCESIVA=false

# --- Solo pruebas automatizadas -----------------------------------
# La suite de pruebas activa esto: sin el limitador de peticiones, sus
# decenas de accesos por segundo serían tomados por un ataque.
# No activarlo en desarrollo ni en producción.
DISABLE_RATE_LIMIT=false
